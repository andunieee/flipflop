// Shared state + logic hooks between the Rust backend and every page.

export struct PeerRow {
    endpoint-id: string,
    name: string,
    // one or two letters for the avatar
    initials: string,
    detail: string,
    online: bool,
    // true: the peer asked to pair with us (Accept/Decline buttons)
    is-request: bool,
    // true: discovered nearby, can be invited to pair ("Pair" button)
    is-suggestion: bool,
    trusted: bool,
    // the browser link's guest (temporary, not paired)
    guest: bool,
    // a send to / receive from this peer is in flight
    sending: bool,
    receiving: bool,
}

// One send or receive, shown on its peer's page until dismissed.
export struct TransferRow {
    // unique per transfer; passed back to stop/cancel/dismiss
    key: string,
    peer-id: string,
    sending: bool,
    // still running (Stop/Cancel) vs. finished (Dismiss)
    active: bool,
    // a send queued until its peer is reachable
    waiting: bool,
    // a quick share (shown on the Quick share page, not a peer's)
    quick: bool,
    title: string,
    progress: float,
    progress-label: string,
    speed: string,
    status: string,
    // secondary line, e.g. "2 files renamed to avoid overwriting"
    note: string,
    error: string,
}

export struct HistoryRow {
    id: string,
    title: string,
    direction: string,
    status: string,
    // badge colour: "ok" | "error" | "warn" | "muted" | "active"
    tone: string,
    detail: string,
    date: string,
    size: string,
    speed: string,
    can-open: bool,
    // pasted text squeezed onto one line; "" for files
    preview: string,
}

// A quick share offered to us, waiting for Accept or Decline.
export struct QuickOffer {
    key: string,
    sender: string,
    initials: string,
    // "report.pdf", "3 items", "text"
    title: string,
    size: string,
}

// An installed app offered by "Send app" (Android).
export struct AppRow {
    package: string,
    name: string,
    // version, and a split-APK warning
    detail: string,
    icon: image,
}

// A file shared into the app (Android share sheet), queued until sent.
export struct OutboxRow {
    path: string,
    name: string,
    size: string,
}

export global State {
    // navigation: "peer" | "add-peer" | "settings", and "quick-share" |
    // "share-link" (desktop) or "share", both on one page (phones)
    in-out property <string> page: "peer";

    // ---- responsive layout -------------------------------------------
    // Window is narrower than the sidebar + content can share.
    in-out property <bool> compact: false;
    // true on touch devices (Android): bigger hit targets, native toasts.
    in-out property <bool> touch: false;
    // Compact layout: the selected peer's page is open over the peer list.
    in-out property <bool> peer-open: false;
    // Shared content staged from the system share sheet and not yet being
    // sent; `outbox-count` is its length.
    in-out property <[OutboxRow]> outbox;
    in-out property <int> outbox-count: 0;
    // Desktop in-app toast (Android uses native toasts); "" = hidden.
    in-out property <string> toast-text: "";
    in-out property <bool> toast-error: false;

    // sidebar
    in-out property <string> my-name: "";
    in-out property <bool> node-ready: false;
    in-out property <[PeerRow]> peers;
    in-out property <string> presence-label: "";

    // add-peer page
    in-out property <[PeerRow]> suggestions;
    in-out property <string> nearby-note: "";
    in-out property <string> add-ticket-input: "";
    in-out property <bool> pairing-busy: false;
    in-out property <string> pairing-status: "";
    in-out property <bool> pairing-error: false;
    in-out property <string> my-ticket: "";
    // our address as a QR code (shown on demand)
    in-out property <bool> show-qr: false;
    in-out property <image> my-qr;
    // camera viewfinder while scanning a peer's QR code (Android)
    in-out property <bool> scanning: false;
    in-out property <image> scan-frame;

    // quick share: devices around (paired or not), shares offered to us,
    // and the quick sends and receives under way or just done
    in-out property <[PeerRow]> nearby-devices;
    in-out property <[QuickOffer]> quick-incoming;
    in-out property <[TransferRow]> quick-transfers;

    // share via link: the new link's choices (anywhere vs. same Wi-Fi,
    // receive vs. send), and the open links
    in-out property <bool> link-web: false;
    in-out property <bool> link-receive: false;
    in-out property <[PeerRow]> links;

    // peer page
    in-out property <string> selected-id: "";
    in-out property <string> selected-name: "";
    in-out property <string> selected-initials: "";
    in-out property <string> selected-detail: "";
    in-out property <bool> selected-online: false;
    // the selected peer is the browser link's guest
    in-out property <bool> selected-guest: false;
    in-out property <bool> rename-mode: false;
    in-out property <string> rename-input: "";
    in-out property <[HistoryRow]> history;
    // peer page tab: "main" (send, receive, history) | "doc" (the document
    // shared with the peer) and that document's text
    in-out property <string> peer-tab: "main";
    in-out property <string> doc-text: "";

    // a send to the selected peer is in flight (hides "Send files…")
    in-out property <bool> selected-sending: false;
    // every send/receive; each peer page shows its own
    in-out property <[TransferRow]> transfers;
    // the selected peer's subset of `transfers` (kept in sync by Rust)
    in-out property <[TransferRow]> visible-transfers;
    // Text box of the peer page's send card
    in-out property <string> paste-input: "";
    // "Send app" chooser (Android): open, still loading, filtered rows
    in-out property <bool> app-picker-open: false;
    in-out property <bool> apps-loading: false;
    in-out property <string> app-filter: "";
    in-out property <[AppRow]> apps;

    // the selected browser link (a temporary page for someone without
    // flipflop): its URL (one of our addresses) and QR code
    in-out property <string> guest-url: "";
    in-out property <image> guest-qr;
    // made for anywhere (the web page over iroh), not the LAN
    in-out property <bool> guest-web: false;
    // its page may send us files and text
    in-out property <bool> guest-upload: false;
    // more than one address to offer ("Try another address")
    in-out property <bool> guest-more-addresses: false;

    // settings page
    // device-name editor (kept apart from my-name so refreshes don't clobber typing)
    in-out property <bool> name-editing: false;
    in-out property <string> name-input: "";
    in-out property <string> downloads-dir: "";
    in-out property <int> relay-mode: 0; // 0 default, 1 disabled, 2 custom
    in-out property <string> relay-urls: "";
    in-out property <string> relay-token: "";
    in-out property <int> relay-fallback: 0; // 0 strict, 1 public
    in-out property <string> relay-test-status: "";
    in-out property <bool> relay-test-failed: false;
    in-out property <int> discovery-mode: 0; // 0 default, 1 custom
    in-out property <string> discovery-pkarr-url: "";
    in-out property <string> discovery-dns-origin: "";
    in-out property <string> discovery-test-status: "";
    in-out property <bool> discovery-test-failed: false;
    in-out property <int> discoverability: 0; // 0 everyone, 1 paired-only, 2 off
    in-out property <bool> history-enabled: true;
    in-out property <int> theme: 0; // 0 system, 1 light, 2 dark
    // set only when saving failed
    in-out property <string> settings-status: "";
}

export global Logic {
    // navigation
    callback page-changed(string);
    // Android Back on a top-level page: leave the app (keeps running).
    callback back-at-root();

    // peers
    callback refresh-peers();
    callback select-peer(string);
    callback rename-peer();
    callback rename-peer-confirm();
    callback rename-peer-cancel();
    callback remove-peer();
    // Desktop: pick files (or a folder) and send them to the selected peer.
    callback send-to-peer();
    callback stop-share(string);
    callback cancel-receive(string);
    callback dismiss-transfer(string);

    // send card: the typed text and the queued files (Android)
    callback send-composed();
    // pasted text
    callback paste-clipboard();

    // share-sheet queue (Android)
    callback outbox-remove(string);
    callback outbox-clear();
    // Add files (desktop: or a folder) / gallery pictures (Android) to the
    // queue with the system pickers.
    callback pick-files();
    callback pick-images();
    // Android "Send app": open the chooser, filter it, queue the chosen APK.
    callback pick-app();
    callback app-filter-changed(string);
    callback app-chosen(string);

    // shared document: the tab was switched; the text was edited
    callback peer-tab-changed(string);
    callback doc-edited(string);

    // per-peer history
    callback refresh-history();
    callback delete-row(string);
    callback open-row(string);
    callback share-row(string);

    // add peer
    callback pair-with-pasted();
    callback accept-suggestion(string);
    callback decline-suggestion(string);
    callback copy-my-ticket();
    callback toggle-my-qr();
    callback scan-qr();
    callback scan-cancel();

    // quick share: send the composer's content to a device (endpoint id);
    // accept or decline a share offered to us (QuickOffer key)
    callback quick-send(string);
    callback quick-accept(string);
    callback quick-decline(string);

    // browser links: make one from `link-web` / `link-receive` (and the
    // composer, for sending); the selected one's controls
    callback link-create();
    callback guest-stop();
    callback guest-copy-url();
    callback guest-next-address();
    callback guest-set-upload(bool);

    // settings
    callback pick-downloads-dir();
    // Save the settings page now (combo boxes, checkboxes)...
    callback save-settings();
    // ...or once typing in a text field pauses.
    callback settings-edited();
    callback rename-self-name();
}
