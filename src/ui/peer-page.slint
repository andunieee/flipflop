import { LineEdit, TextEdit } from "std-widgets.slint";
import { State, Logic, HistoryRow, TransferRow, AppRow } from "globals.slint";
import {
    Theme, Dot, Card, ProgressBar, HintText, Avatar, Badge, DirectionIcon,
    PrimaryButton, SecondaryButton, GhostButton, DangerButton, SectionTitle,
    Icon, Icons, IconButton, LogoMark, Divider, ScrollView,
} from "components.slint";

component HistoryItem inherits Rectangle {
    in property <HistoryRow> entry;

    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    animate background { duration: 90ms; }
    ta := TouchArea {
        mouse-cursor: root.entry.can-open ? pointer : default;
        clicked => {
            if root.entry.can-open {
                Logic.open-row(root.entry.id);
            }
        }
    }

    HorizontalLayout {
        padding: Theme.space-3;
        padding-left: Theme.space-3 + 2px;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;
            DirectionIcon { sending: root.entry.direction == "send"; size: 30px; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            Text {
                text: root.entry.title;
                color: Theme.text-strong;
                font-weight: 600;
                overflow: elide;
            }
            if root.entry.preview != "": Text {
                text: root.entry.preview;
                color: Theme.text;
                font-size: Theme.font-sm;
                overflow: elide;
            }
            Text {
                text: State.touch ? root.entry.size + " · " + root.entry.date
                    : root.entry.detail == "" ? root.entry.size
                    : root.entry.size + " · " + root.entry.detail;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: end;
                Badge { label: root.entry.status; tone: root.entry.tone; }
            }
            if !State.touch: Text {
                text: root.entry.date;
                color: Theme.text-faint;
                font-size: Theme.font-xs;
                horizontal-alignment: right;
            }
        }

        // Fixed-width action column keeps badges aligned across rows.
        HorizontalLayout {
            width: State.touch ? 2 * Theme.control-height : 112px;
            alignment: end;
            spacing: Theme.space-1;
            if root.entry.can-open && State.touch: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.share;
                    clicked => { Logic.share-row(root.entry.id); }
                }
            }
            if root.entry.can-open && !State.touch: VerticalLayout {
                alignment: center;
                GhostButton {
                    label: "Open";
                    icon: Icons.open;
                    clicked => { Logic.open-row(root.entry.id); }
                }
            }
            if root.entry.tone != "active": VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.close;
                    clicked => { Logic.delete-row(root.entry.id); }
                }
            }
        }
    }
}

component TransferCard inherits Card {
    in property <TransferRow> transfer;

    VerticalLayout {
        padding: Theme.card-padding;
        spacing: Theme.space-3;

        HorizontalLayout {
            spacing: Theme.space-3;

            VerticalLayout {
                alignment: center;
                DirectionIcon { sending: root.transfer.sending; size: 36px; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;

                Text {
                    text: (root.transfer.sending ? "Sending " : "Receiving ") + root.transfer.title;
                    color: Theme.text-strong;
                    font-weight: 650;
                    overflow: elide;
                }
                Text {
                    text: root.transfer.speed == "" ? root.transfer.status
                        : root.transfer.status + " · " + root.transfer.speed;
                    color: root.transfer.error != "" ? Theme.error : Theme.text-muted;
                    font-size: Theme.font-sm;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                if root.transfer.active: SecondaryButton {
                    label: root.transfer.sending ? "Stop" : "Cancel";
                    clicked => {
                        if root.transfer.sending {
                            Logic.stop-share(root.transfer.key);
                        } else {
                            Logic.cancel-receive(root.transfer.key);
                        }
                    }
                }
                if !root.transfer.active: GhostButton {
                    label: "Dismiss";
                    clicked => { Logic.dismiss-transfer(root.transfer.key); }
                }
            }
        }

        if root.transfer.active || root.transfer.progress > 0: VerticalLayout {
            spacing: 6px;
            ProgressBar {
                value: root.transfer.progress;
                tint: root.transfer.error != "" ? Theme.error
                    : !root.transfer.active ? Theme.success
                    : Theme.accent;
            }
            if root.transfer.progress-label != "": Text {
                text: root.transfer.progress-label;
                color: Theme.text-faint;
                font-size: Theme.font-xs;
            }
        }

        if root.transfer.note != "": HintText { label: root.transfer.note; }
        if root.transfer.error != "": Text {
            text: root.transfer.error;
            color: Theme.error;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
}

// Inline rename field (shown while `State.rename-mode`).
component RenameRow inherits HorizontalLayout {
    spacing: Theme.space-2;
    name-field := LineEdit {
        text <=> State.rename-input;
        placeholder-text: "Peer name";
        horizontal-stretch: 1;
        accepted => { Logic.rename-peer-confirm(); }
    }
    PrimaryButton {
        label: "Save";
        clicked => {
            // Losing focus commits the keyboard's composing text on Android.
            name-field.clear-focus();
            Logic.rename-peer-confirm();
        }
    }
    GhostButton { label: "Cancel"; clicked => { Logic.rename-peer-cancel(); } }
}

// "Forget <peer>?" with an explicit, solid confirm button.
component ForgetConfirm inherits Rectangle {
    callback cancelled;
    callback confirmed;

    border-radius: Theme.radius;
    background: Theme.error-soft;
    border-width: 1px;
    border-color: Theme.error-border;

    VerticalLayout {
        padding: Theme.space-3;
        padding-left: Theme.space-4;
        spacing: Theme.space-2;

        Text {
            text: "Forget " + State.selected-name + "? You'll need to pair again to exchange files.";
            color: Theme.text-strong;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-2;
            GhostButton { label: "Cancel"; clicked => { root.cancelled(); } }
            DangerButton {
                label: "Forget";
                icon: Icons.trash;
                solid: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}

// No peers yet / none selected.
export component EmptyPeersCard inherits Card {
    VerticalLayout {
        padding: Theme.space-5;
        spacing: Theme.space-3;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            padding-bottom: Theme.space-1;
            LogoMark { size: 56px; }
        }
        Text {
            text: State.peers.length == 0 ? "Pair your first device" : "Choose a peer";
            color: Theme.text-strong;
            font-size: Theme.font-lg;
            font-weight: 700;
            horizontal-alignment: center;
        }
        if State.peers.length == 0: HorizontalLayout {
            alignment: center;
            PrimaryButton {
                label: "Add a peer";
                icon: Icons.add-peer;
                clicked => {
                    State.page = "add-peer";
                    Logic.page-changed("add-peer");
                }
            }
        }
    }
}

// Queued files (share sheet, pickers), each with a remove button.
component OutboxFiles inherits VerticalLayout {
    spacing: Theme.space-1;
    for file in State.outbox: HorizontalLayout {
        spacing: Theme.space-2;
        padding-left: Theme.space-1;
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.file; size: 16px; tint: Theme.text-muted; }
        }
        Text {
            text: file.name;
            color: Theme.text;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: file.size;
            color: Theme.text-faint;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
        IconButton {
            icon: Icons.close;
            clicked => { Logic.outbox-remove(file.path); }
        }
    }
}

// Share-sheet queue on the peer list, waiting for a peer to be picked.
export component OutboxCard inherits Card {
    border-color: Theme.accent-border;

    VerticalLayout {
        padding: Theme.card-padding;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-3;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 10px;
                    background: Theme.accent-soft;
                    Icon { source: Icons.inbox; size: 18px; tint: Theme.accent-text; }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: State.outbox-count == 1 ? "1 file ready to send" : State.outbox-count + " files ready to send";
                    color: Theme.text-strong;
                    font-weight: 650;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                GhostButton { label: "Clear"; clicked => { Logic.outbox-clear(); } }
            }
        }

        OutboxFiles { }
    }
}

// Attachment action of the send card: icon over a short label.
component AttachButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;

    horizontal-stretch: 1;
    height: State.touch ? 60px : 52px;
    border-radius: Theme.radius-sm + 2px;
    background: !root.enabled ? Theme.chip-bg
        : touch.pressed ? Theme.chip-bg-press
        : touch.has-hover ? Theme.chip-bg-hover
        : Theme.chip-bg;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;
    animate background { duration: 90ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Icon { source: root.icon; size: 20px; tint: Theme.accent-text; }
        }
        Text {
            text: root.label;
            color: Theme.text-strong;
            font-size: Theme.font-xs;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
}

// Everything sent to a peer starts here: type or paste text, attach
// pictures / an app / files, then Send. Android queues attachments (listed
// above the text box) until Send; desktop only has Files, which sends right
// away.
component SendCard inherits Card {
    border-color: State.outbox-count > 0 ? Theme.accent-border : Theme.border;

    VerticalLayout {
        padding: Theme.card-padding;
        spacing: Theme.space-3;

        HorizontalLayout {
            spacing: Theme.space-3;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 10px;
                    background: Theme.accent-soft;
                    Icon { source: Icons.send; size: 18px; tint: Theme.accent-text; }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Send to " + State.selected-name;
                    color: Theme.text-strong;
                    font-weight: 650;
                    overflow: elide;
                }
                if State.outbox-count > 0: Text {
                    text: State.outbox-count == 1 ? "1 file attached" : State.outbox-count + " files attached";
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                }
            }
            if State.outbox-count > 0: VerticalLayout {
                alignment: center;
                GhostButton { label: "Clear"; clicked => { Logic.outbox-clear(); } }
            }
        }

        if State.outbox-count > 0: OutboxFiles { }

        text-box := TextEdit {
            text <=> State.paste-input;
            placeholder-text: "Type or paste text…";
            wrap: word-wrap;
            height: 96px;
        }

        HorizontalLayout {
            spacing: Theme.space-2;
            AttachButton {
                label: "Paste";
                icon: Icons.clipboard;
                clicked => { Logic.paste-clipboard(); }
            }
            if State.touch: AttachButton {
                label: "Picture";
                icon: Icons.image;
                clicked => { Logic.pick-images(); }
            }
            if State.touch: AttachButton {
                label: "App";
                icon: Icons.apps;
                clicked => { Logic.pick-app(); }
            }
            AttachButton {
                label: "Files";
                icon: Icons.folder;
                enabled: State.touch || !State.selected-sending;
                clicked => {
                    if State.touch {
                        Logic.pick-files();
                    } else {
                        Logic.send-to-peer();
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: State.touch ? stretch : end;
            PrimaryButton {
                label: State.selected-sending ? "Sending…" : "Send";
                icon: Icons.send;
                enabled: !State.selected-sending
                    && (State.paste-input != "" || State.outbox-count > 0);
                clicked => {
                    // Losing focus commits the keyboard's composing text on Android.
                    text-box.clear-focus();
                    Logic.send-composed();
                }
            }
        }
    }
}

component HistoryHeader inherits HorizontalLayout {
    padding-top: Theme.space-2;
    SectionTitle { label: "History"; horizontal-stretch: 1; }
    if State.touch: IconButton { icon: Icons.refresh; clicked => { Logic.refresh-history(); } }
    if !State.touch: GhostButton { label: "Refresh"; icon: Icons.refresh; clicked => { Logic.refresh-history(); } }
}

component NoHistory inherits Rectangle {
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    height: 64px;
    Text {
        text: "No transfers with " + State.selected-name + " yet.";
        color: Theme.text-faint;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PresenceLine inherits HorizontalLayout {
    in property <bool> show-detail;
    spacing: 6px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Dot { online: State.selected-online; size: 7px; }
    }
    Text {
        text: State.selected-online ? "Online" : "Offline";
        color: State.selected-online ? Theme.online : Theme.text-muted;
        font-size: Theme.font-sm;
        font-weight: 600;
        vertical-alignment: center;
    }
    if root.show-detail: Text {
        text: "· " + State.selected-detail;
        color: Theme.text-faint;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

// Desktop / wide layout: the selected peer next to the sidebar.
component WidePeerView inherits Rectangle {
    property <bool> has-peer: State.selected-name != "";
    property <bool> confirm-forget: false;
    // A pending "Forget?" never carries over to another peer.
    property <string> selected-id: State.selected-id;
    changed selected-id => { root.confirm-forget = false; }

    VerticalLayout {
        padding: Theme.page-padding;
        spacing: Theme.space-4;

        if root.has-peer: HorizontalLayout {
            spacing: Theme.space-3 + 2px;

            VerticalLayout {
                alignment: center;
                Avatar { initials: State.selected-initials; size: 52px; }
            }
            VerticalLayout {
                alignment: center;
                spacing: Theme.space-1;
                horizontal-stretch: 1;
                Text {
                    text: State.selected-name;
                    color: Theme.text-strong;
                    font-size: Theme.font-xl;
                    font-weight: 700;
                    overflow: elide;
                }
                PresenceLine { show-detail: true; }
            }
            if !State.rename-mode && !root.confirm-forget: HorizontalLayout {
                spacing: Theme.space-1;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    GhostButton { label: "Rename"; icon: Icons.edit; clicked => { Logic.rename-peer(); } }
                }
                VerticalLayout {
                    alignment: center;
                    DangerButton { label: "Forget"; icon: Icons.trash; clicked => { root.confirm-forget = true; } }
                }
            }
        }

        if root.has-peer && root.confirm-forget: ForgetConfirm {
            cancelled => { root.confirm-forget = false; }
            confirmed => {
                root.confirm-forget = false;
                Logic.remove-peer();
            }
        }
        if State.rename-mode: RenameRow { }
        if !root.has-peer: EmptyPeersCard { }

        if root.has-peer: SendCard { }

        for transfer in State.visible-transfers: TransferCard { transfer: transfer; }

        if root.has-peer: HistoryHeader { }
        if root.has-peer && State.history.length == 0: NoHistory { }
        if root.has-peer && State.history.length > 0: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                // Room for the scrollbar so it never covers row actions.
                padding-right: Theme.space-3;
                for entry in State.history: HistoryItem { entry: entry; }
            }
        }

        if !root.has-peer || State.history.length == 0: Rectangle { vertical-stretch: 1; }
    }
}

// Phone layout: one peer's own screen, opened from the peer list. Everything
// scrolls together; Forget lives in its own section at the very bottom.
component PhonePeerView inherits Rectangle {
    property <bool> confirm-forget: false;
    property <string> selected-id: State.selected-id;
    changed selected-id => { root.confirm-forget = false; }

    ScrollView {
        VerticalLayout {
            padding: Theme.page-padding;
            padding-top: Theme.space-2;
            spacing: Theme.space-4;
            alignment: start;

            HorizontalLayout {
                spacing: Theme.space-2;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.arrow-left;
                        tint: Theme.text-strong;
                        clicked => { State.peer-open = false; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Avatar { initials: State.selected-initials; size: 44px; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    padding-left: Theme.space-1;
                    Text {
                        text: State.selected-name;
                        color: Theme.text-strong;
                        font-size: Theme.font-xl;
                        font-weight: 700;
                        overflow: elide;
                    }
                    PresenceLine { }
                }
                if !State.rename-mode: VerticalLayout {
                    alignment: center;
                    IconButton { icon: Icons.edit; clicked => { Logic.rename-peer(); } }
                }
            }

            if State.rename-mode: RenameRow { }

            SendCard { }

            for transfer in State.visible-transfers: TransferCard { transfer: transfer; }

            HistoryHeader { }
            if State.history.length == 0: NoHistory { }
            for entry in State.history: HistoryItem { entry: entry; }

            // Danger zone, out of the way of everyday actions.
            VerticalLayout {
                padding-top: Theme.space-4;
                spacing: Theme.space-3;
                Divider { }
                if !root.confirm-forget: HorizontalLayout {
                    spacing: Theme.space-3;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: "Forget this peer";
                            color: Theme.text-strong;
                            font-weight: 600;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        DangerButton { label: "Forget"; clicked => { root.confirm-forget = true; } }
                    }
                }
                if root.confirm-forget: ForgetConfirm {
                    cancelled => { root.confirm-forget = false; }
                    confirmed => {
                        root.confirm-forget = false;
                        State.peer-open = false;
                        Logic.remove-peer();
                    }
                }
            }
        }
    }
}

export component PeerPage inherits Rectangle {
    if !State.compact: WidePeerView { width: 100%; height: 100%; }
    if State.compact: PhonePeerView { width: 100%; height: 100%; }
}

component AppItem inherits Rectangle {
    in property <AppRow> app;

    height: State.touch ? 60px : 48px;
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.chip-bg-hover : ta.has-hover ? Theme.chip-bg : transparent;
    animate background { duration: 90ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Logic.app-chosen(root.app.package); }
    }

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.app.icon;
                width: 36px;
                height: 36px;
                image-fit: contain;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.app.name;
                color: Theme.text-strong;
                font-weight: 600;
                overflow: elide;
            }
            if root.app.detail != "": Text {
                text: root.app.detail;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
        }
    }
}

// "Send app" chooser (Android): installed apps, filterable; picking one
// queues its APK in the send card.
export component AppPickerSheet inherits Rectangle {
    in property <length> inset-top;
    in property <length> inset-bottom;

    background: Theme.shadow;
    // Swallow clicks meant for the page underneath; tapping outside closes.
    TouchArea { clicked => { State.app-picker-open = false; } }

    Rectangle {
        x: State.compact ? 0 : (parent.width - self.width) / 2;
        y: State.compact ? 0 : (parent.height - self.height) / 2;
        width: State.compact ? parent.width : min(parent.width - 48px, 480px);
        height: State.compact ? parent.height : min(parent.height - 48px, 640px);
        border-radius: State.compact ? 0 : Theme.radius-lg;
        background: Theme.window-bg;
        TouchArea { }

        VerticalLayout {
            padding: Theme.page-padding;
            padding-top: Theme.page-padding + (State.compact ? root.inset-top : 0);
            padding-bottom: Theme.page-padding + (State.compact ? root.inset-bottom : 0);
            spacing: Theme.space-3;

            HorizontalLayout {
                spacing: Theme.space-2;
                Text {
                    text: "Send an app";
                    color: Theme.text-strong;
                    font-size: Theme.font-lg;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.close;
                    tint: Theme.text-strong;
                    clicked => { State.app-picker-open = false; }
                }
            }
            LineEdit {
                text <=> State.app-filter;
                placeholder-text: "Search apps";
                edited(text) => { Logic.app-filter-changed(text); }
            }
            if State.apps-loading: Text {
                text: "Loading apps…";
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-stretch: 1;
                vertical-alignment: center;
            }
            if !State.apps-loading && State.apps.length == 0: Text {
                text: State.app-filter == "" ? "No installed apps to send." : "No app matches.";
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-stretch: 1;
                vertical-alignment: center;
            }
            if !State.apps-loading && State.apps.length > 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    for app in State.apps: AppItem { app: app; }
                }
            }
        }
    }
}
