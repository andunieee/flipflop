import { Button, ScrollView } from "std-widgets.slint";
import { State, Logic, HistoryRow } from "globals.slint";
import { PageTitle, HintText } from "components.slint";

component HistoryItem inherits Rectangle {
    in property <HistoryRow> entry;
    border-radius: 6px;
    background: #232330;
    min-height: 64px;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.entry.direction == "send" ? "↑" : "↓";
                color: root.entry.direction == "send" ? #d0a040 : #40a0d0;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.entry.title;
                color: white;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.entry.status;
                color: root.entry.failed ? #ff8a98 : #8fd08f;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.entry.detail;
                color: #9a9aac;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.entry.size;
                color: #9a9aac;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                text: root.entry.speed;
                color: #9a9aac;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                text: root.entry.date;
                color: #8a8a9a;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.entry.can-open: Button {
                text: "Open";
                clicked => { Logic.open-row(root.entry.id); }
            }
            Button {
                text: "✕";
                clicked => { Logic.delete-row(root.entry.id); }
            }
        }
    }
}

export component HistoryPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 14px;
        alignment: start;

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: "History";
                font-size: 22px;
                font-weight: 700;
                color: white;
                vertical-stretch: 0;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Refresh"; clicked => { Logic.refresh-history(); } }
            Button { text: "Clear all"; clicked => { Logic.clear-history(); } }
        }

        if State.history.length == 0: HintText { label: "No transfers recorded yet."; }

        if State.history.length > 0: Rectangle {
            border-radius: 6px;
            background: transparent;

            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    spacing: 8px;
                    alignment: start;

                    for entry in State.history: HistoryItem {
                        entry: entry;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
