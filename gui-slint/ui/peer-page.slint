import { Button, ScrollView, LineEdit } from "std-widgets.slint";
import { State, Logic, HistoryRow } from "globals.slint";
import { ProgressBar, HintText, StatusText } from "components.slint";

component HistoryItem inherits Rectangle {
    in property <HistoryRow> entry;
    border-radius: 6px;
    background: #232330;
    min-height: State.touch ? 76px : 64px;

    VerticalLayout {
        padding: State.touch ? 12px : 10px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.entry.direction == "send" ? "↑" : "↓";
                color: root.entry.direction == "send" ? #d0a040 : #40a0d0;
                font-weight: 700;
                font-size: State.touch ? 15px : 13px;
                vertical-alignment: center;
            }
            Text {
                text: root.entry.title;
                color: white;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.entry.status;
                color: root.entry.failed ? #ff8a98 : #8fd08f;
                font-size: State.touch ? 13px : 11px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: State.touch ? 8px : 12px;
            Text {
                text: root.entry.detail;
                color: #9a9aac;
                font-size: State.touch ? 13px : 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.entry.size;
                color: #9a9aac;
                font-size: State.touch ? 13px : 11px;
                vertical-alignment: center;
            }
            if !State.touch: Text {
                text: root.entry.date;
                color: #8a8a9a;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.entry.can-open && !State.touch: Button {
                text: "Open";
                clicked => { Logic.open-row(root.entry.id); }
            }
            Button {
                text: "✕";
                clicked => { Logic.delete-row(root.entry.id); }
            }
        }
    }
}

component TransferPanel inherits Rectangle {
    in property <bool> sending: true;
    in property <float> progress: 0.0;
    in property <string> progress-label: "";
    in property <string> status: "";
    in property <string> error: "";
    in property <bool> can-cancel: false;
    callback cancel();

    border-radius: 6px;
    background: #232330;
    min-height: State.touch ? 88px : 72px;

    VerticalLayout {
        padding: State.touch ? 12px : 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.sending ? "↑ Sending" : "↓ Receiving";
                color: white;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.can-cancel: Button {
                text: "Stop";
                clicked => { root.cancel(); }
            }
        }

        ProgressBar { value: root.progress; label: root.progress-label; }

        Text {
            text: root.status;
            color: #9a9aac;
            font-size: State.touch ? 13px : 11px;
            overflow: elide;
            wrap: State.touch ? word-wrap : no-wrap;
        }

        if root.error != "": StatusText { label: root.error; error: true; }
    }
}

// Compact-mode peer switcher chip (opens the picker below it).
component PeerChip inherits Rectangle {
    in property <string> endpoint-id;
    in property <string> label;
    in property <bool> online;

    border-radius: 8px;
    background: State.selected-id == root.endpoint-id ? #4a5fd0 : #232330;
    min-height: State.touch ? 48px : 40px;

    touch := TouchArea {
        clicked => {
            Logic.select-peer(root.endpoint-id);
            State.show-peer-picker = false;
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.online ? #7bd88f : #4a4a58;
        }
        Text {
            text: root.label;
            color: State.selected-id == root.endpoint-id ? white : #c8c8d0;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component PeerPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: State.touch ? 12px : 16px;
        spacing: State.touch ? 10px : 14px;
        alignment: start;

        // Header
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: State.selected-name == "" ? "No peer selected" : State.selected-name;
                    color: white;
                    font-size: State.touch ? 19px : 22px;
                    font-weight: 700;
                    vertical-stretch: 0;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: State.selected-online ? #7bd88f : #4a4a58;
                    }
                    Text {
                        text: State.selected-detail == ""
                            ? "Select a peer, or add one."
                            : State.selected-detail;
                        color: State.selected-detail == "" ? #9a9aac : #8a8a9a;
                        font-size: State.touch ? 13px : 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if State.selected-name != "" && !State.rename-mode: Button {
                text: "Rename";
                clicked => { Logic.rename-peer(); }
            }
            if State.selected-name != "" && !State.rename-mode: Button {
                text: "Forget";
                clicked => { Logic.remove-peer(); }
            }
        }

        // Compact layout has no sidebar: pick the peer here.
        if State.compact && State.peers.length > 0: Rectangle {
            border-radius: 8px;
            background: #232330;
            min-height: 48px;

            chip-touch := TouchArea {
                clicked => { State.show-peer-picker = !State.show-peer-picker; }
                mouse-cursor: pointer;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: State.selected-online ? #7bd88f : #4a4a58;
                }
                Text {
                    text: State.selected-name == "" ? "Choose a peer" : State.selected-name;
                    color: white;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: State.show-peer-picker ? "▲" : "▼";
                    color: #9a9aac;
                    vertical-alignment: center;
                }
            }
        }

        if State.compact && State.show-peer-picker: ScrollView {
            max-height: 240px;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                for peer in State.peers: PeerChip {
                    endpoint-id: peer.endpoint-id;
                    label: peer.name;
                    online: peer.online;
                }
            }
        }

        // Inline rename
        if State.rename-mode: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            LineEdit {
                text <=> State.rename-input;
                min-width: State.touch ? 140px : 260px;
                horizontal-stretch: 1;
                accepted => { Logic.rename-peer-confirm(); }
            }
            Button {
                text: "Save";
                primary: true;
                clicked => { Logic.rename-peer-confirm(); }
            }
            Button {
                text: "Cancel";
                clicked => { Logic.rename-peer-cancel(); }
            }
        }

        // Active transfers
        if State.selected-id != "" && State.send-active-id == State.selected-id
           && (State.share-starting || State.send-status != "" || State.send-error != ""):
        TransferPanel {
            sending: true;
            progress: State.send-progress;
            progress-label: State.send-progress-label;
            status: State.send-status;
            error: State.send-error;
            can-cancel: State.share-starting || State.send-status == "Transferring…" || State.send-peers > 0;
            cancel() => { Logic.stop-share(); }
        }

        if State.selected-id != "" && State.receive-active-id == State.selected-id
           && (State.receive-status != "" || State.receive-error != ""):
        TransferPanel {
            sending: false;
            progress: State.receive-progress;
            progress-label: State.receive-progress-label;
            status: State.receive-speed == "" ? State.receive-status
                : State.receive-status + " · " + State.receive-speed;
            error: State.receive-error;
            cancel() => { Logic.cancel-receive(); }
        }

        // Send button (no transfer in flight for this peer)
        if State.selected-name != "" && State.send-active-id != State.selected-id:
        Rectangle {
            min-height: State.touch ? 48px : 0px;
            border-radius: 6px;
            background: #4a5fd0;

            send-touch := TouchArea {
                clicked => { Logic.send-to-peer(); }
                mouse-cursor: pointer;
            }

            HorizontalLayout {
                alignment: center;
                Text {
                    text: "Send files…";
                    color: white;
                    font-size: State.touch ? 16px : 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // Content shared into the app via the system share sheet.
        if State.touch && State.outbox-count > 0:
            HintText { label: State.outbox-count + " file(s) staged from the share sheet — pick a peer and send."; }

        // History for this peer
        Rectangle { min-height: 4px; }

        HorizontalLayout {
            Text {
                text: "Transfers";
                font-size: 15px;
                font-weight: 700;
                color: white;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Refresh"; clicked => { Logic.refresh-history(); } }
        }

        if State.selected-name == "":
            HintText { label: "Add a peer with the + button to start sending files."; }

        if State.selected-name != "" && State.history.length == 0:
            HintText { label: "No transfers with this peer yet."; }

        ScrollView {
            VerticalLayout {
                spacing: 8px;
                alignment: start;

                for entry in State.history: HistoryItem {
                    entry: entry;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
