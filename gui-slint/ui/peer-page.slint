import { ScrollView, LineEdit } from "std-widgets.slint";
import { State, Logic, HistoryRow } from "globals.slint";
import {
    Theme, Dot, Card, ProgressBar, HintText, StatusText,
    PrimaryButton, GhostButton, DangerButton, SectionTitle,
} from "components.slint";

component HistoryItem inherits Card {
    in property <HistoryRow> entry;
    min-height: State.touch ? 76px : 64px;

    VerticalLayout {
        padding: State.touch ? 12px : 10px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 18px;
                border-radius: Theme.radius-sm;
                label := Text {
                    text: root.entry.direction == "send" ? "↑" : "↓";
                    color: root.entry.direction == "send" ? Theme.warn : Theme.info;
                    font-weight: 800;
                    font-size: State.touch ? 15px : 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            Text {
                text: root.entry.title;
                color: Theme.text-strong;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.entry.status;
                color: root.entry.failed ? Theme.error : Theme.success;
                font-size: State.touch ? 13px : 11px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: State.touch ? 8px : 12px;
            Text {
                text: root.entry.detail;
                color: Theme.text-muted;
                font-size: State.touch ? 13px : 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.entry.size;
                color: Theme.text-muted;
                font-size: State.touch ? 13px : 11px;
                vertical-alignment: center;
            }
            if !State.touch: Text {
                text: root.entry.date;
                color: Theme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.entry.can-open && !State.touch: GhostButton {
                label: "Open";
                clicked => { Logic.open-row(root.entry.id); }
            }
            if State.touch: GhostButton {
                label: root.entry.can-open ? "Open" : "Delete";
                clicked => { root.entry.can-open ? Logic.open-row(root.entry.id) : Logic.delete-row(root.entry.id); }
            }
            if !State.touch: DangerButton {
                label: "✕";
                clicked => { Logic.delete-row(root.entry.id); }
            }
        }
    }
}

component TransferPanel inherits Card {
    in property <bool> sending: true;
    in property <float> progress: 0.0;
    in property <string> progress-label: "";
    in property <string> status: "";
    in property <string> error: "";
    in property <bool> can-cancel: false;
    in property <string> cancel-label: "Stop";
    callback cancel();

    min-height: State.touch ? 88px : 76px;

    VerticalLayout {
        padding: State.touch ? 12px : 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.sending ? "↑ Sending" : "↓ Receiving";
                color: Theme.text-strong;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.can-cancel: GhostButton {
                label: root.cancel-label;
                clicked => { root.cancel(); }
            }
        }

        ProgressBar { value: root.progress; label: root.progress-label; }

        Text {
            text: root.status;
            color: Theme.text-muted;
            font-size: State.touch ? 13px : 11px;
            overflow: elide;
            wrap: State.touch ? word-wrap : no-wrap;
        }

        if root.error != "": StatusText { label: root.error; error: true; }
    }
}

// Compact-mode peer switcher chip (opens the picker below it).
component PeerChip inherits Rectangle {
    in property <string> endpoint-id;
    in property <string> label;
    in property <bool> online;

    border-radius: Theme.radius;
    background: State.selected-id == root.endpoint-id ? Theme.accent-soft
        : ta.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    min-height: State.touch ? 48px : 40px;

    ta := TouchArea {
        clicked => {
            Logic.select-peer(root.endpoint-id);
            State.show-peer-picker = false;
        }
        mouse-cursor: pointer;
    }
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: start;

        Dot { online: root.online; }
        Text {
            text: root.label;
            color: State.selected-id == root.endpoint-id ? Theme.text-strong : Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component PeerPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: State.touch ? 12px : 18px;
        spacing: State.touch ? 10px : 14px;
        alignment: start;

        // Header
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: State.selected-name == "" ? "No peer selected" : State.selected-name;
                    color: Theme.text-strong;
                    font-size: State.touch ? 19px : 24px;
                    font-weight: 800;
                    vertical-stretch: 0;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Dot { online: State.selected-online; }
                    Text {
                        text: State.selected-detail == "" ? "Select a peer, or add one." : State.selected-detail;
                        color: State.selected-detail == "" ? Theme.text-muted : Theme.text-faint;
                        font-size: State.touch ? 13px : 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if State.selected-name != "" && State.rename-mode == false: HorizontalLayout {
                spacing: 6px;
                GhostButton { label: "Rename"; clicked => { Logic.rename-peer(); } }
                DangerButton { label: "Forget"; clicked => { Logic.remove-peer(); } }
            }
        }

        // Compact layout has no sidebar: pick the peer here.
        if State.compact && State.peers.length > 0: Rectangle {
            border-radius: Theme.radius;
            background: Theme.card-bg;
            min-height: 48px;

            chip-touch := TouchArea {
                clicked => { State.show-peer-picker = !State.show-peer-picker; }
                mouse-cursor: pointer;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                Dot { online: State.selected-online; }
                Text {
                    text: State.selected-name == "" ? "Choose a peer" : State.selected-name;
                    color: Theme.text-strong;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: State.show-peer-picker ? "▲" : "▼";
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        if State.compact && State.show-peer-picker: ScrollView {
            max-height: 240px;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                for peer in State.peers: PeerChip {
                    endpoint-id: peer.endpoint-id;
                    label: peer.name;
                    online: peer.online;
                }
            }
        }

        // Inline rename
        if State.rename-mode: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            LineEdit {
                text <=> State.rename-input;
                min-width: State.touch ? 140px : 260px;
                horizontal-stretch: 1;
                accepted => { Logic.rename-peer-confirm(); }
            }
            PrimaryButton { label: "Save"; clicked => { Logic.rename-peer-confirm(); } }
            GhostButton { label: "Cancel"; clicked => { Logic.rename-peer-cancel(); } }
        }

        // Active transfers
        if State.selected-id != "" && State.send-active-id == State.selected-id
           && (State.share-starting || State.send-status != "" || State.send-error != ""):
        TransferPanel {
            sending: true;
            progress: State.send-progress;
            progress-label: State.send-progress-label;
            status: State.send-status;
            error: State.send-error;
            // Always closable: the share stays open after delivery (and after
            // a failed delivery), so this is the only way to release it.
            can-cancel: true;
            cancel-label: State.send-error != "" ? "Close" : "Stop";
            cancel() => { Logic.stop-share(); }
        }

        if State.selected-id != "" && State.receive-active-id == State.selected-id
           && (State.receive-status != "" || State.receive-error != ""):
        TransferPanel {
            sending: false;
            progress: State.receive-progress;
            progress-label: State.receive-progress-label;
            status: State.receive-speed == "" ? State.receive-status
                : State.receive-status + " · " + State.receive-speed;
            error: State.receive-error;
            can-cancel: true;
            cancel-label: "Cancel";
            cancel() => { Logic.cancel-receive(); }
        }

        // Send button (no transfer in flight for this peer)
        if State.selected-name != "" && State.send-active-id != State.selected-id:
        PrimaryButton {
            label: "Send files…";
            min-height: State.touch ? 46px : 36px;
            clicked => { Logic.send-to-peer(); }
        }

        // Content shared into the app via the system share sheet.
        if State.touch && State.outbox-count > 0:
            HintText { label: State.outbox-count + " file(s) staged from the share sheet — pick a peer and send."; }

        // History for this peer
        Rectangle { min-height: 6px; }

        HorizontalLayout {
            spacing: 8px;
            SectionTitle { label: "Transfers"; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            GhostButton { label: "Refresh"; clicked => { Logic.refresh-history(); } }
        }

        if State.selected-name == "":
            HintText { label: "Add a peer with the + button to start sending files."; }

        if State.selected-name != "" && State.history.length == 0:
            HintText { label: "No transfers with this peer yet."; }

        ScrollView {
            VerticalLayout {
                spacing: 8px;
                alignment: start;

                for entry in State.history: HistoryItem {
                    entry: entry;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
