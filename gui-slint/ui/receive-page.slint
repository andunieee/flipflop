import { Button, ScrollView, LineEdit } from "std-widgets.slint";
import { State, Logic } from "globals.slint";
import { PageTitle, ProgressBar, HintText, StatusText, FieldLabel } from "components.slint";

export component ReceivePage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 14px;
        alignment: start;

        PageTitle { label: "Receive files"; }

        FieldLabel { label: "Ticket:"; }
        LineEdit {
            text <=> State.ticket-input;
            placeholder-text: "Paste a DashBeam ticket…";
            enabled: !State.receive-active;
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            if !State.receive-active && !State.receive-done: Button {
                text: State.info-loaded ? "Re-check" : "Check ticket";
                enabled: State.ticket-input != "" && !State.fetching-info;
                clicked => { Logic.fetch-info(); }
            }
            if State.fetching-info: Button { text: "Checking…"; enabled: false; }
        }

        // Metadata card
        if State.info-loaded: Rectangle {
            border-radius: 6px;
            background: #232330;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "📥";
                        vertical-alignment: center;
                    }
                    Text {
                        text: State.receive-name;
                        color: white;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: State.receive-size;
                        color: #9a9aac;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    if State.receive-count > 1: Text {
                        text: State.receive-count + " items";
                        color: #9a9aac;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Save to…"; enabled: !State.receive-active; clicked => { Logic.pick-save-dir(); } }
                    Text {
                        text: State.save-dir;
                        color: #9a9aac;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                if !State.receive-active && !State.receive-done: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "Download"; primary: true; clicked => { Logic.start-download(); } }
                }
                if State.receive-active: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "Cancel"; clicked => { Logic.cancel-download(); } }
                }
                if State.receive-active: ProgressBar {
                    value: State.receive-progress;
                    label: State.receive-progress-label;
                }
                if State.receive-active: Text {
                    text: State.receive-speed;
                    color: #9a9aac;
                    font-size: 11px;
                }
                if State.receive-done: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "Open folder"; clicked => { Logic.open-received(); } }
                }
                StatusText { label: State.receive-status; error: false; }
            }
        }

        if State.receive-error != "": StatusText {
            text: State.receive-error;
            error: true;
        }

        Rectangle { vertical-stretch: 1; }

        HintText { label: "Files are end-to-end encrypted and verified with BLAKE3. Partial downloads resume automatically for the same ticket."; }
    }
}
