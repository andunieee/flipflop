import { ScrollView, LineEdit } from "std-widgets.slint";
import { State, Logic, PeerRow } from "globals.slint";
import {
    Theme, Card, HintText, StatusText, SectionTitle,
    PrimaryButton, GhostButton,
} from "components.slint";

component SuggestionRow inherits Card {
    in property <PeerRow> entry;
    min-height: State.touch ? 60px : 48px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.info;
        }

        VerticalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 2px;
            Text {
                text: root.entry.name;
                color: Theme.text-strong;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.entry.detail;
                color: Theme.text-muted;
                font-size: State.touch ? 13px : 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if root.entry.is-request: HorizontalLayout {
            spacing: 6px;
            PrimaryButton { label: "Accept"; clicked => { Logic.accept-suggestion(root.entry.endpoint-id); } }
            GhostButton { label: "Decline"; clicked => { Logic.decline-suggestion(root.entry.endpoint-id); } }
        }
        if root.entry.is-suggestion: PrimaryButton {
            label: "Pair";
            clicked => { Logic.accept-suggestion(root.entry.endpoint-id); }
        }
    }
}

export component AddPeerPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: State.touch ? 12px : 18px;
        spacing: State.touch ? 10px : 14px;
        alignment: start;

        Text {
            text: "Add a peer";
            font-size: State.touch ? 19px : 24px;
            font-weight: 800;
            color: Theme.text-strong;
            vertical-stretch: 0;
        }

        // Paste an address
        Text {
            text: "Paste their TunnelManager / iroh address:";
            color: Theme.text;
            font-size: State.touch ? 13px : 12px;
            vertical-stretch: 0;
            wrap: word-wrap;
        }

        Card {
            VerticalLayout {
                spacing: 8px;
                padding: State.touch ? 10px : 12px;

                LineEdit {
                    text <=> State.add-ticket-input;
                    placeholder-text: "iroh node id or pairing ticket";
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    PrimaryButton {
                        label: "Connect";
                        enabled: State.add-ticket-input != "" && !State.pairing-busy;
                        clicked => { Logic.pair-with-pasted(); }
                    }
                    if State.pairing-busy: HintText { label: "Connecting…"; vertical-alignment: center; }
                    if State.pairing-status != "": StatusText {
                        label: State.pairing-status;
                        error: State.pairing-error;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Suggestions
        Rectangle { min-height: 6px; }
        SectionTitle { label: "Suggested peers"; vertical-stretch: 0; }
        HintText {
            label: State.nearby-note == ""
                ? "Peers on your local network, or peers who already asked to connect with you."
                : State.nearby-note;
        }

        ScrollView {
            VerticalLayout {
                spacing: 8px;
                alignment: start;

                for node in State.suggestions: SuggestionRow {
                    entry: node;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        // Our own invite
        Card {
            VerticalLayout {
                padding: State.touch ? 10px : 12px;
                spacing: 6px;

                Text {
                    text: "Want them to add you instead?";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-stretch: 0;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: State.my-ticket;
                        color: Theme.text-muted;
                        font-size: State.touch ? 12px : 11px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    GhostButton { label: "Copy"; clicked => { Logic.copy-my-ticket(); } }
                }
            }
        }
    }
}
