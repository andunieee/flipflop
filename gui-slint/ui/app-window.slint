import { State, Logic } from "globals.slint";
import { SendPage } from "send-page.slint";
import { ReceivePage } from "receive-page.slint";
import { HistoryPage } from "history-page.slint";
import { SettingsPage } from "settings-page.slint";

export { State, Logic }

component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <bool> active;

    border-radius: 6px;
    background: active ? #4a5fd0 : transparent;
    min-height: 36px;

    touch := TouchArea {
        clicked => {
            State.page = root.key;
            Logic.page-changed(root.key);
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? white : #c8c8d0;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "DashBeam";
    background: #1b1b23;
    preferred-width: 920px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 520px;

    VerticalLayout {
        HorizontalLayout {
            // Sidebar
            Rectangle {
                min-width: 160px;
                max-width: 160px;
                background: #20202b;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: "DashBeam";
                        font-size: 18px;
                        font-weight: 700;
                        color: white;
                    }

                    NavButton { label: "Send"; key: "send"; active: State.page == "send"; }
                    NavButton { label: "Receive"; key: "receive"; active: State.page == "receive"; }
                    NavButton { label: "History"; key: "history"; active: State.page == "history"; }
                    NavButton { label: "Settings"; key: "settings"; active: State.page == "settings"; }

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: "Slint GUI (alt)";
                        color: #6a6a78;
                        font-size: 10px;
                    }
                }
            }

            // Content
            Rectangle {
                if State.page == "send": SendPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "receive": ReceivePage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "history": HistoryPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "settings": SettingsPage {
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Toast / status bar
        Rectangle {
            min-height: 26px;
            max-height: 26px;
            background: State.toast-error ? #5a2030 : #232330;
            HorizontalLayout {
                padding-left: 12px;
                Text {
                    text: State.toast;
                    color: State.toast-error ? #ff9aa8 : #b8b8c8;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
