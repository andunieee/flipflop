import { State, Logic } from "globals.slint";
import { ScrollView } from "std-widgets.slint";
import { PeerPage } from "peer-page.slint";
import { AddPeerPage } from "add-peer-page.slint";
import { SettingsPage } from "settings-page.slint";

export { State, Logic }

component AddPeerButton inherits Rectangle {
    border-radius: 6px;
    background: #37374a;
    min-height: 34px;

    touch := TouchArea {
        clicked => {
            State.page = "add-peer";
            Logic.page-changed("add-peer");
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        alignment: center;

        Text {
            text: "+ Add peer";
            color: white;
            vertical-alignment: center;
        }
    }
}

component PeerButton inherits Rectangle {
    in property <string> endpoint-id;
    in property <string> label;
    in property <bool> online;

    border-radius: 6px;
    background: State.page == "peer" && State.selected-id == self.endpoint-id
        ? #4a5fd0
        : transparent;
    min-height: 34px;

    touch := TouchArea {
        clicked => {
            Logic.select-peer(root.endpoint-id);
            State.page = "peer";
            Logic.page-changed("peer");
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.online ? #7bd88f : #4a4a58;
            }
            Text {
                text: root.label;
                color: State.selected-id == root.endpoint-id ? white : #c8c8d0;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component NavBottomButton inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <bool> active;

    border-radius: 6px;
    background: active ? #37374a : transparent;
    min-height: 34px;

    touch := TouchArea {
        clicked => {
            State.page = root.key;
            Logic.page-changed(root.key);
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        Text {
            text: root.label;
            color: root.active ? white : #c8c8d0;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "DashBeam";
    background: #1b1b23;
    preferred-width: 920px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 520px;

    VerticalLayout {
        HorizontalLayout {
            // Sidebar
            Rectangle {
                min-width: 210px;
                max-width: 210px;
                background: #20202b;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: "DashBeam";
                        font-size: 18px;
                        font-weight: 700;
                        color: white;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: State.my-name;
                            color: #9a9aac;
                            font-size: 11px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if !State.node-ready: Text {
                            text: "(starting…)";
                            color: #d0a040;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { min-height: 6px; }

                    AddPeerButton { }

                    if State.peers.length > 0: Rectangle { min-height: 6px; }

                    ScrollView {
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            for peer in State.peers: PeerButton {
                                endpoint-id: peer.endpoint-id;
                                label: peer.name;
                                online: peer.online;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    NavBottomButton { label: "Settings"; key: "settings"; active: State.page == "settings"; }

                    Text {
                        text: State.presence-label;
                        color: #6a6a78;
                        font-size: 10px;
                    }
                }
            }

            // Content
            Rectangle {
                if State.page == "peer": PeerPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "add-peer": AddPeerPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "settings": SettingsPage {
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Toast / status bar
        Rectangle {
            min-height: 26px;
            max-height: 26px;
            background: State.toast-error ? #5a2030 : #232330;
            HorizontalLayout {
                padding-left: 12px;
                Text {
                    text: State.toast;
                    color: State.toast-error ? #ff9aa8 : #b8b8c8;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
