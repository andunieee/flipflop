import { State, Logic } from "globals.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme, Dot } from "components.slint";
import { PeerPage } from "peer-page.slint";
import { AddPeerPage } from "add-peer-page.slint";
import { SettingsPage } from "settings-page.slint";

export { State, Logic }

component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <bool> active;
    in property <bool> compact;

    border-radius: root.compact ? Theme.radius : Theme.radius-sm;
    background: root.active ? Theme.accent-soft
        : ta.has-hover && !root.compact ? Theme.chip-bg-hover
        : transparent;
    min-height: root.compact ? 52px : 34px;

    ta := TouchArea {
        clicked => {
            State.page = root.key;
            Logic.page-changed(root.key);
        }
        mouse-cursor: pointer;
    }
    animate background { duration: 90ms; }

    VerticalLayout {
        alignment: center;
        padding-left: root.compact ? 0 : 12px;

        if root.compact: Text {
            text: root.label;
            color: root.active ? Theme.text-strong : Theme.text;
            font-size: 20px;
            horizontal-alignment: center;
        }
        if !root.compact: Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

component PeerButton inherits Rectangle {
    in property <string> endpoint-id;
    in property <string> label;
    in property <bool> online;
    in property <bool> compact;

    border-radius: Theme.radius-sm;
    background: State.page == "peer" && State.selected-id == self.endpoint-id
        ? Theme.accent-soft
        : ta.has-hover ? Theme.chip-bg-hover
        : transparent;
    min-height: root.compact ? 48px : 34px;

    ta := TouchArea {
        clicked => {
            Logic.select-peer(root.endpoint-id);
            State.page = "peer";
            Logic.page-changed("peer");
        }
        mouse-cursor: pointer;
    }
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        Dot { online: root.online; }
        Text {
            text: root.label;
            color: State.selected-id == root.endpoint-id ? Theme.text-strong : Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component AddPeerButton inherits Rectangle {
    in property <bool> compact;

    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.chip-bg-hover : Theme.chip-bg;
    min-height: root.compact ? 48px : 34px;

    ta := TouchArea {
        clicked => {
            State.page = "add-peer";
            Logic.page-changed("add-peer");
        }
        mouse-cursor: pointer;
    }
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 12px;
        alignment: center;

        Text {
            text: "+ Add peer";
            color: Theme.text-strong;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "TunnelManager";
    background: Theme.window-bg;
    // Single-pane layout (no sidebar) with a bottom nav instead.
    property <bool> compact;

    // On phones the OS gives us a small window; don't force desktop sizes.
    preferred-width: State.touch ? 360px : 920px;
    preferred-height: State.touch ? 720px : 640px;
    min-width: State.touch ? 0px : 720px;
    min-height: State.touch ? 0px : 520px;

    // Responsive mode: no room for the fixed 210px sidebar. Driven purely
    // by State.touch (Rust): binding it to the window width creates a
    // layout binding loop, and the desktop window enforces min-width 720px.
    compact: State.touch;

    VerticalLayout {
        HorizontalLayout {
            // Sidebar: desktop + wide tablets only.
            if !root.compact: Rectangle {
                min-width: 220px;
                max-width: 220px;
                background: Theme.sidebar-bg;

                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    alignment: start;

                    // App header
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "TunnelManager";
                            font-size: 17px;
                            font-weight: 800;
                            color: Theme.text-strong;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Dot { online: State.node-ready; }
                            Text {
                                text: State.my-name == "" ? "…" : State.my-name;
                                color: Theme.text-muted;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            if !State.node-ready: Text {
                                text: "starting…";
                                color: Theme.warn;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { min-height: 10px; }

                    AddPeerButton { compact: false; }

                    if State.peers.length > 0: Rectangle { min-height: 10px; }

                    if State.peers.length > 0: Text {
                        text: "Peers";
                        color: Theme.text-faint;
                        font-size: 11px;
                        font-weight: 600;
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            for peer in State.peers: PeerButton {
                                endpoint-id: peer.endpoint-id;
                                label: peer.name;
                                online: peer.online;
                                compact: false;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    NavButton { label: "Settings"; key: "settings"; active: State.page == "settings"; compact: false; }

                    Rectangle { min-height: 4px; }

                    Text {
                        text: State.presence-label;
                        color: Theme.text-faint;
                        font-size: 10px;
                    }
                }
            }

            // Content
            Rectangle {
                if State.page == "peer": PeerPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "add-peer": AddPeerPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "settings": SettingsPage {
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Bottom nav on compact layouts (phones): thumb-reachable, larger
        // hit targets than the desktop sidebar.
        if root.compact: Rectangle {
            min-height: 64px;
            max-height: 64px;
            background: Theme.sidebar-bg;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                NavButton { label: "Peers"; key: "peer"; active: State.page == "peer"; compact: true; }
                NavButton { label: "Add"; key: "add-peer"; active: State.page == "add-peer"; compact: true; }
                NavButton { label: "⚙"; key: "settings"; active: State.page == "settings"; compact: true; }
            }
        }
    }

    // Desktop toast (Android shows native toasts instead). Click to dismiss;
    // Rust clears it after a few seconds.
    if State.toast-text != "": Rectangle {
        width: min(toast-text.preferred-width + 32px, root.width - 32px);
        height: toast-text.preferred-height + 20px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 20px;
        border-radius: Theme.radius;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: State.toast-error ? Theme.error : Theme.accent-soft;
        drop-shadow-color: #0006;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;

        toast-text := Text {
            x: 16px;
            y: 10px;
            width: parent.width - 32px;
            text: State.toast-text;
            color: State.toast-error ? Theme.error : Theme.text-strong;
            wrap: word-wrap;
        }
        TouchArea {
            clicked => { State.toast-text = ""; }
            mouse-cursor: pointer;
        }
    }
}
