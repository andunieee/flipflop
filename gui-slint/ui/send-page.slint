import { Button, ScrollView } from "std-widgets.slint";
import { State, Logic } from "globals.slint";
import { PageTitle, ProgressBar, HintText, StatusText, FieldLabel } from "components.slint";

export component SendPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 14px;
        alignment: start;

        PageTitle { label: "Send files"; }

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Button { text: "Choose files"; enabled: !State.share-active && !State.share-starting; clicked => { Logic.pick-files(); } }
            Button { text: "Choose folder"; enabled: !State.share-active && !State.share-starting; clicked => { Logic.pick-folder(); } }
            Button { text: "Clear"; enabled: !State.share-active && !State.share-starting && State.send-items.length > 0; clicked => { Logic.remove-item(-1); } }
        }

        // Selected items
        if State.send-items.length > 0: Rectangle {
            border-radius: 6px;
            background: #232330;
            min-height: 120px;
            max-height: 180px;

            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    alignment: start;

                    for item[index] in State.send-items: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: (item.is-dir ? "📁 " : "📄 ") + item.name;
                            color: #e0e0ea;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: item.size;
                            color: #8a8a9a;
                            font-size: 11px;
                            vertical-alignment: center;
                            min-width: 70px;
                            horizontal-alignment: right;
                        }
                        Button {
                            text: "✕";
                            enabled: !State.share-active && !State.share-starting;
                            clicked => { Logic.remove-item(index); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            if !State.share-active && !State.share-starting: Button {
                text: "Share";
                primary: true;
                enabled: State.send-items.length > 0;
                clicked => { Logic.start-share(); }
            }
            if State.share-starting: Button {
                text: "Starting…";
                enabled: false;
            }
            if State.share-active: Button {
                text: "Stop sharing";
                clicked => { Logic.stop-share(); }
            }
        }

        // Share result panel
        if State.share-active: Rectangle {
            border-radius: 6px;
            background: #232330;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                FieldLabel { label: "Share this ticket with the receiver:"; }
                Rectangle {
                    border-radius: 4px;
                    background: #1b1b23;
                    min-height: 64px;
                    ScrollView {
                        HorizontalLayout {
                            padding: 8px;
                            Text {
                                text: State.ticket;
                                color: #b8d0ff;
                                font-size: 11px;
                                wrap: word-wrap;
                                vertical-alignment: top;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "Copy ticket"; clicked => { Logic.copy-ticket(); } }
                }
                ProgressBar {
                    value: State.send-progress;
                    label: State.send-progress-label;
                }
                StatusText {
                    text: State.send-status;
                    error: false;
                }
            }
        }

        if State.share-starting: HintText { label: "Importing and preparing share…"; }

        if State.send-error != "": StatusText {
            text: State.send-error;
            error: true;
        }

        Rectangle { vertical-stretch: 1; }

        HintText { label: "The receiver pastes the ticket on their DashBeam instance. Sharing keeps running until stopped or the app closes."; }
    }
}
