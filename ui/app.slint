import { Palette } from "std-widgets.slint";
import {
    State, Logic, Theme, Icons, Icon, Avatar, Dot, Overline, Badge, HintText, LogoMark, IconButton,
    PrimaryButton, SecondaryButton, DangerButton, GhostButton, Field, Card, ScrollView, AppRow, GroupRow,
} from "components.slint";
import { GroupPage } from "group.slint";
import { GroupsPage, PeersPage, AddPage, SettingsPage } from "pages.slint";

export {
    State,
    Logic,
}
export { PeerRow, GroupRow, InviteRow, MemberRow, CandidateRow, FileRow, TextRow, AppRow } from "components.slint";

component SideButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    in property <int> badge;
    callback clicked;

    height: 36px;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent-soft
        : ta.pressed ? Theme.chip-bg-hover
        : ta.has-hover ? Theme.chip-bg
        : transparent;
    animate background { duration: 90ms; }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2 + 2px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 18px;
                tint: root.active ? Theme.accent-text : Theme.text-muted;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text-strong : Theme.text;
            font-size: Theme.font-md;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.badge > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: max(18px, side-badge.preferred-width + 10px);
                border-radius: 9px;
                background: Theme.accent;
                side-badge := Text {
                    text: root.badge;
                    color: white;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component GroupButton inherits Rectangle {
    in property <GroupRow> group;
    property <bool> selected: State.page == "group" && State.open-group == root.group.id;

    height: 40px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent-soft
        : ta.pressed ? Theme.chip-bg-hover
        : ta.has-hover ? Theme.chip-bg
        : transparent;
    animate background { duration: 90ms; }

    ta := TouchArea {
        clicked => { Logic.open-group(root.group.id); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-3;
        spacing: Theme.space-2 + 2px;
        VerticalLayout {
            alignment: center;
            Avatar {
                icon: Icons.groups;
                size: 26px;
                show-presence: true;
                online: root.group.online;
            }
        }
        Text {
            text: root.group.title;
            color: root.selected ? Theme.text-strong : Theme.text;
            font-size: Theme.font-md;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// Bottom navigation entry (phones).
component TabButton inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <image> icon;
    in property <int> badge;
    in property <bool> active;
    callback clicked;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? Theme.accent-soft : ta.pressed ? Theme.chip-bg : transparent;
                animate background { duration: 120ms; }
                Icon {
                    source: root.icon;
                    size: 22px;
                    tint: root.active ? Theme.accent-text : Theme.text-muted;
                }
                if root.badge > 0: Rectangle {
                    x: parent.width / 2 + 4px;
                    y: 0px;
                    height: 16px;
                    width: max(16px, badge-text.preferred-width + 8px);
                    border-radius: 8px;
                    background: Theme.accent;
                    badge-text := Text {
                        text: root.badge;
                        color: white;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text-strong : Theme.text-muted;
            font-size: Theme.font-xs;
            font-weight: root.active ? 700 : 500;
            horizontal-alignment: center;
        }
    }
}

component NodeStatus inherits HorizontalLayout {
    spacing: 6px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Dot {
            online: State.node-ready;
            size: 7px;
        }
    }
    Text {
        text: !State.node-ready ? "Starting…" : State.my-name == "" ? "Online" : State.my-name;
        color: State.node-ready ? Theme.text-muted : Theme.warn;
        font-size: Theme.font-xs;
        overflow: elide;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "flipflop";
    icon: Icons.logo;
    background: Theme.window-bg;
    default-font-size: Theme.font-md;

    preferred-width: State.touch ? 360px : 960px;
    preferred-height: State.touch ? 720px : 660px;
    min-width: State.touch ? 0px : 640px;
    min-height: State.touch ? 0px : 480px;

    // Space under the Android navigation bar or the soft keyboard (the keyboard height already
    // reaches down over the navigation bar).
    property <length> bottom-inset: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
    // Some devices report their navigation bar here, so only a tall inset counts as a keyboard.
    property <bool> keyboard-up: root.virtual-keyboard-size.height > 120px;
    property <bool> in-group: State.page == "group";

    // Toast: the latest status line, for a few seconds.
    property <bool> toast-visible: false;
    property <string> status: State.status;
    changed status => {
        if (root.status != "") {
            root.toast-visible = true;
            toast-timer.running = true;
        }
    }
    toast-timer := Timer {
        interval: 4s;
        running: false;
        triggered => {
            self.running = false;
            root.toast-visible = false;
        }
    }

    FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        // Android Back: dialog → group → groups → (let Android handle it).
        key-pressed(event) => {
            if event.text != Key.Back {
                return reject;
            }
            if State.app-picker-open {
                State.app-picker-open = false;
            } else if State.edit-kind != "" {
                State.edit-kind = "";
            } else if State.scanning {
                Logic.cancel-scan();
            } else if State.page == "group" {
                Logic.close-group();
            } else if State.page != "groups" {
                State.page = "groups";
            } else {
                return reject;
            }
            accept
        }

        VerticalLayout {
            // Phone app bar under the status bar.
            if State.touch: Rectangle {
                height: root.safe-area-insets.top + 56px;
                background: Theme.window-bg;
                HorizontalLayout {
                    padding-top: root.safe-area-insets.top;
                    padding-left: Theme.page-padding + root.safe-area-insets.left;
                    padding-right: Theme.page-padding + root.safe-area-insets.right;
                    spacing: Theme.space-3;
                    VerticalLayout {
                        alignment: center;
                        LogoMark { size: 32px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;
                        Text {
                            text: "flipflop";
                            font-size: Theme.font-lg;
                            font-weight: 700;
                            color: Theme.text-strong;
                        }
                        NodeStatus { }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                // Sidebar (desktop).
                if !State.touch: Rectangle {
                    width: 240px;
                    background: Theme.sidebar-bg;
                    VerticalLayout {
                        padding: Theme.space-3;
                        spacing: Theme.space-1;

                        HorizontalLayout {
                            padding: Theme.space-1;
                            spacing: Theme.space-3;
                            VerticalLayout {
                                alignment: center;
                                LogoMark { size: 34px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "flipflop";
                                    font-size: Theme.font-lg;
                                    font-weight: 700;
                                    color: Theme.text-strong;
                                }
                                NodeStatus { }
                            }
                        }

                        Rectangle { height: Theme.space-3; }

                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            Overline {
                                label: "GROUPS";
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            IconButton {
                                width: 28px;
                                height: 28px;
                                icon: Icons.add-peer;
                                tint: Theme.accent-text;
                                clicked => { Logic.new-group(); }
                            }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 2px;
                                for invite in State.invites: SideButton {
                                    label: "Invitation: " + invite.group-title;
                                    icon: Icons.groups;
                                    active: false;
                                    badge: 1;
                                    clicked => { State.page = "groups"; }
                                }
                                for group in State.groups: GroupButton { group: group; }
                                if State.groups.length == 0 && State.invites.length == 0: Text {
                                    text: "No groups yet";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-faint;
                                    horizontal-alignment: center;
                                    height: 40px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        SideButton {
                            label: "All groups";
                            icon: Icons.groups;
                            active: State.page == "groups";
                            badge: State.invites.length;
                            clicked => { State.page = "groups"; }
                        }
                        SideButton {
                            label: "Peers";
                            icon: Icons.peers;
                            active: State.page == "peers";
                            clicked => { State.page = "peers"; }
                        }
                        SideButton {
                            label: "Add a peer";
                            icon: Icons.add-peer;
                            active: State.page == "add";
                            clicked => { State.page = "add"; }
                        }
                        SideButton {
                            label: "Settings";
                            icon: Icons.settings;
                            active: State.page == "settings";
                            clicked => { State.page = "settings"; }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.border;
                    }
                }

                // Page
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    if State.scanning && State.live-camera: VerticalLayout {
                        padding: Theme.page-padding;
                        spacing: Theme.space-3;
                        Text {
                            text: "Point the camera at a flipflop code";
                            horizontal-alignment: center;
                            color: Theme.text-strong;
                            font-size: Theme.font-md;
                        }
                        Image {
                            source: State.camera-frame;
                            image-fit: contain;
                            vertical-stretch: 1;
                        }
                        SecondaryButton {
                            label: "Cancel";
                            clicked => { Logic.cancel-scan(); }
                        }
                    }
                    if !(State.scanning && State.live-camera) && State.page == "groups": GroupsPage { }
                    if !(State.scanning && State.live-camera) && State.page == "group": GroupPage { }
                    if !(State.scanning && State.live-camera) && State.page == "peers": PeersPage { }
                    if !(State.scanning && State.live-camera) && State.page == "add": AddPage { }
                    if !(State.scanning && State.live-camera) && State.page == "settings": SettingsPage { }
                }
            }

            // Bottom navigation (phones), hidden while typing.
            if State.touch && !root.keyboard-up: Rectangle {
                height: 64px + root.safe-area-insets.bottom;
                background: Theme.window-bg;
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding-bottom: root.safe-area-insets.bottom;
                    padding-left: root.safe-area-insets.left;
                    padding-right: root.safe-area-insets.right;
                    TabButton {
                        label: "Groups";
                        icon: Icons.groups;
                        badge: State.invites.length;
                        active: State.page == "groups" || State.page == "group";
                        clicked => {
                            if State.page == "group" { Logic.close-group(); }
                            State.page = "groups";
                        }
                    }
                    TabButton {
                        label: "Peers";
                        icon: Icons.peers;
                        active: State.page == "peers";
                        clicked => { State.page = "peers"; }
                    }
                    TabButton {
                        label: "Add";
                        icon: Icons.add-peer;
                        active: State.page == "add";
                        clicked => { State.page = "add"; }
                    }
                    TabButton {
                        label: "Settings";
                        icon: Icons.settings;
                        active: State.page == "settings";
                        clicked => { State.page = "settings"; }
                    }
                }
            }
            if State.touch && root.keyboard-up: Rectangle {
                height: root.virtual-keyboard-size.height;
            }
        }

        // Toast
        if root.toast-visible && State.status != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - (State.touch ? 80px + root.bottom-inset : 24px);
            width: min(parent.width - 32px, toast-text.preferred-width + 32px);
            height: toast-text.preferred-height + 20px;
            border-radius: Theme.radius;
            background: Theme.text-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
            toast-text := Text {
                x: 16px;
                width: parent.width - 32px;
                text: State.status;
                color: Theme.window-bg;
                font-size: Theme.font-sm;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Rename / delete dialog
        if State.edit-kind != "": Rectangle {
            background: #000000.with-alpha(0.55);
            TouchArea {
                clicked => { State.edit-kind = ""; }
            }
            Rectangle {
                width: min(parent.width - 32px, 400px);
                height: edit-card.preferred-height;
                y: root.safe-area-insets.top + 80px;
                border-radius: Theme.radius-lg;
                background: Theme.card-bg;
                border-width: 1px;
                border-color: Theme.border-strong;
                TouchArea { }
                edit-card := VerticalLayout {
                    padding: Theme.card-padding;
                    spacing: Theme.space-2;
                    Text {
                        text: State.edit-kind == "peer" ? "Rename peer" : "Rename group";
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        color: Theme.text-strong;
                    }
                    Text {
                        text: State.edit-original;
                        font-size: Theme.font-sm;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    Field {
                        text <=> State.edit-text;
                        placeholder: "Local name (empty restores the original)";
                        accepted(t) => {
                            Logic.save-edit(State.edit-kind, State.edit-id, t);
                            State.edit-kind = "";
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PrimaryButton {
                            label: "Save";
                            clicked => {
                                Logic.save-edit(State.edit-kind, State.edit-id, State.edit-text);
                                State.edit-kind = "";
                            }
                        }
                        SecondaryButton {
                            label: "Cancel";
                            clicked => { State.edit-kind = ""; }
                        }
                        DangerButton {
                            label: State.edit-kind == "peer" ? "Remove" : "Leave";
                            clicked => {
                                Logic.delete-edit(State.edit-kind, State.edit-id);
                                State.edit-kind = "";
                            }
                        }
                    }
                }
            }
        }

        // Installed apps (Android)
        if State.app-picker-open: Rectangle {
            background: #000000.with-alpha(0.55);
            TouchArea {
                clicked => { State.app-picker-open = false; }
            }
            Rectangle {
                x: 0;
                y: parent.height * 0.15;
                width: parent.width;
                height: parent.height * 0.85;
                border-top-left-radius: Theme.radius-lg;
                border-top-right-radius: Theme.radius-lg;
                background: Theme.window-bg;
                TouchArea { }
                VerticalLayout {
                    padding: Theme.page-padding;
                    padding-bottom: Theme.space-3 + root.bottom-inset;
                    spacing: Theme.space-3;
                    HorizontalLayout {
                        Text {
                            text: "Share an app";
                            font-size: Theme.font-xl;
                            font-weight: 700;
                            color: Theme.text-strong;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        IconButton {
                            icon: Icons.close;
                            clicked => { State.app-picker-open = false; }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: Theme.space-2;
                            for app in State.apps: Card {
                                ta := TouchArea {
                                    clicked => {
                                        State.app-picker-open = false;
                                        Logic.share-app(app.path);
                                    }
                                }
                                VerticalLayout {
                                    padding: Theme.space-3;
                                    spacing: 2px;
                                    Text {
                                        text: app.name;
                                        font-size: Theme.font-md;
                                        font-weight: 650;
                                        color: Theme.text-strong;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: app.detail;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-muted;
                                        overflow: elide;
                                    }
                                }
                            }
                            if State.apps.length == 0: HintText {
                                label: "No apps found.";
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
