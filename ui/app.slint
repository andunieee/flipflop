import { Button, LineEdit, ListView, Palette, ScrollView, VerticalBox } from "std-widgets.slint";

export struct PeerItem {
    id: string,
    /// Alias if set, else the peer's own name.
    title: string,
    /// The peer's own name, shown dimmed when an alias hides it.
    subtitle: string,
    alias: string,
    short: string,
    lan: bool,
    ble: bool,
    connected: bool,
    saved: bool,
}

export struct GroupItem {
    id: string,
    title: string,
    /// The haiku, shown dimmed when an alias replaces it as the title.
    subtitle: string,
    summary: string,
}

export struct InviteItem {
    inviter-id: string,
    group-id: string,
    inviter-name: string,
    group-title: string,
}

export struct MemberItem {
    name: string,
    status: string,
    /// 0 joined, 1 invited, 2 waiting for them to be online, 3 declined
    kind: int,
}

export struct CandidateItem {
    id: string,
    name: string,
}

export struct ChatLine {
    mine: bool,
    text: string,
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: #3b82f6;
    background: tint.with-alpha(0.18);
    border-radius: 4px;
    border-width: 1px;
    border-color: tint.with-alpha(0.6);
    Text {
        text: root.text;
        color: root.tint;
        font-size: 11px;
        horizontal-alignment: center;
        x: 6px;
        width: parent.width - 12px;
    }
    min-width: label.preferred-width + 12px;
    height: 20px;
    label := Text {
        text: root.text;
        font-size: 11px;
        visible: false;
    }
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    background: active ? #3b82f6.with-alpha(0.2) : transparent;
    Text {
        text: root.text;
        font-size: 15px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "flipflop";
    preferred-width: 420px;
    preferred-height: 720px;
    min-width: 320px;
    min-height: 480px;

    in-out property <string> my-name;
    in property <string> status;
    in property <string> ble-status;
    in property <[PeerItem]> peers;
    in property <[GroupItem]> groups;
    in property <[InviteItem]> invites;
    in-out property <string> open-group;
    in property <string> group-title;
    in property <string> group-haiku;
    in property <string> group-alias;
    in property <[MemberItem]> members;
    in property <[CandidateItem]> candidates;
    in-out property <string> edit-kind;
    in-out property <string> edit-id;
    in-out property <string> edit-original;
    in-out property <string> edit-text;
    in property <image> qr;
    in property <string> ticket;
    in property <[ChatLine]> chat;
    in-out property <string> chat-peer-id;
    in property <string> chat-peer-name;
    in property <image> camera-frame;
    in-out property <bool> scanning;
    in property <bool> live-camera;
    in-out property <int> tab: 0;

    // Space taken at the bottom by the Android navigation bar or, while it is up, the soft keyboard.
    // The reported keyboard height already reaches down over the navigation bar. (Deriving it from the
    // window height instead would be a binding loop with the root layout.)
    property <length> bottom-inset: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);

    callback rename(string);
    callback connect(string);
    callback new-group();
    callback open-group-id(string);
    callback close-group();
    callback add-to-group(string, string);
    callback accept-invite(string, string);
    callback reject-invite(string, string);
    callback save-edit(string, string, string);
    callback delete-edit(string, string);
    callback open-chat(string);
    callback close-chat();
    callback send(string);
    callback connect-ticket(string);
    callback scan();
    callback cancel-scan();

    VerticalLayout {
        padding: 12px;
        padding-top: 12px + root.safe-area-insets.top;
        padding-bottom: 12px + root.bottom-inset;
        padding-left: 12px + root.safe-area-insets.left;
        padding-right: 12px + root.safe-area-insets.right;
        spacing: 10px;

        // Identity
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "This device";
                font-size: 12px;
                opacity: 0.7;
            }
            HorizontalLayout {
                spacing: 8px;
                name-edit := LineEdit {
                    text <=> root.my-name;
                    placeholder-text: "Device name";
                    accepted(t) => { root.rename(t); }
                }
                Button {
                    text: "Save";
                    clicked => { root.rename(name-edit.text); }
                }
            }
        }

        if root.scanning && root.live-camera: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                text: "Point the camera at a flipflop QR code";
                horizontal-alignment: center;
            }
            Image {
                source: root.camera-frame;
                image-fit: contain;
                vertical-stretch: 1;
            }
            Button {
                text: "Cancel";
                clicked => { root.cancel-scan(); }
            }
        }

        if !(root.scanning && root.live-camera) && root.chat-peer-id != "": VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "‹ Back";
                    clicked => { root.close-chat(); }
                }
                Text {
                    text: root.chat-peer-name;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            ListView {
                vertical-stretch: 1;
                for line in root.chat: Rectangle {
                    height: msg.preferred-height + 12px + 8px;
                    bubble := Rectangle {
                        x: line.mine ? parent.width - self.width : 0px;
                        y: 4px;
                        width: min(parent.width * 0.8, msg.preferred-width + 20px);
                        height: msg.preferred-height + 12px;
                        border-radius: 10px;
                        background: line.mine ? #3b82f6 : #6b7280.with-alpha(0.35);
                        msg := Text {
                            x: 10px;
                            y: 6px;
                            width: parent.width - 20px;
                            text: line.text;
                            wrap: word-wrap;
                            color: line.mine ? white : Palette.foreground;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                msg-edit := LineEdit {
                    placeholder-text: "Message";
                    accepted(t) => {
                        root.send(t);
                        self.text = "";
                    }
                }
                Button {
                    text: "Send";
                    clicked => {
                        root.send(msg-edit.text);
                        msg-edit.text = "";
                    }
                }
            }
        }

        if !(root.scanning && root.live-camera) && root.chat-peer-id == "": VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 4px;
                height: 40px;
                Tab {
                    text: "Peers";
                    active: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                Tab {
                    text: "Groups" + (root.invites.length > 0 ? " (" + root.invites.length + ")" : "");
                    active: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                Tab {
                    text: "Add by QR";
                    active: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
            }

            // ---- Peers ----
            if root.tab == 0: VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;
                if root.peers.length == 0: Text {
                    text: "No one around yet.\nOther flipflop devices on this network or in Bluetooth range show up here. Peers you connect to are saved and reconnect automatically.";
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    opacity: 0.7;
                    vertical-stretch: 1;
                    vertical-alignment: center;
                }
                if root.peers.length > 0: ListView {
                    vertical-stretch: 1;
                    for peer in root.peers: Rectangle {
                        height: 72px;
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: peer.title;
                                    font-size: 16px;
                                    overflow: elide;
                                }
                                Text {
                                    text: (peer.subtitle != "" ? peer.subtitle + " · " : "") + peer.short;
                                    font-size: 11px;
                                    opacity: 0.55;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    if peer.connected: Badge {
                                        text: "connected";
                                        tint: #22c55e;
                                    }
                                    if peer.saved && !peer.connected: Badge {
                                        text: "offline";
                                        tint: #6b7280;
                                    }
                                    if peer.lan: Badge { text: "LAN"; }
                                    if peer.ble: Badge {
                                        text: "BLE";
                                        tint: #a855f7;
                                    }
                                }
                            }
                            if peer.connected: Button {
                                text: "Chat";
                                primary: true;
                                clicked => { root.open-chat(peer.id); }
                            }
                            if !peer.connected: Button {
                                text: "Connect";
                                primary: !peer.saved;
                                clicked => { root.connect(peer.id); }
                            }
                            if peer.saved: Button {
                                text: "Edit";
                                clicked => {
                                    root.edit-kind = "peer";
                                    root.edit-id = peer.id;
                                    root.edit-original = peer.subtitle != "" ? peer.subtitle : peer.title;
                                    root.edit-text = peer.alias;
                                }
                            }
                        }
                    }
                }
            }

            // ---- Groups: list ----
            if root.tab == 1 && root.open-group == "": VerticalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                Button {
                    text: "New group";
                    primary: true;
                    clicked => { root.new-group(); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                    for invite in root.invites: Rectangle {
                        height: 96px;
                        background: #3b82f6.with-alpha(0.12);
                        border-radius: 8px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text {
                                text: invite.inviter-name + " invites you to join";
                                font-size: 12px;
                                opacity: 0.8;
                                overflow: elide;
                            }
                            Text {
                                text: invite.group-title;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Accept";
                                    primary: true;
                                    clicked => { root.accept-invite(invite.inviter-id, invite.group-id); }
                                }
                                Button {
                                    text: "Decline";
                                    clicked => { root.reject-invite(invite.inviter-id, invite.group-id); }
                                }
                            }
                        }
                    }
                    for group in root.groups: Rectangle {
                        height: group.subtitle != "" ? 84px : 72px;
                        VerticalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 3px;
                            alignment: center;
                            Text {
                                text: group.title;
                                font-size: 15px;
                                wrap: word-wrap;
                            }
                            if group.subtitle != "": Text {
                                text: group.subtitle;
                                font-size: 11px;
                                opacity: 0.55;
                                wrap: word-wrap;
                            }
                            Text {
                                text: group.summary;
                                font-size: 11px;
                                opacity: 0.7;
                            }
                        }
                        TouchArea {
                            clicked => { root.open-group-id(group.id); }
                        }
                    }
                                    }
                }
                if root.groups.length == 0 && root.invites.length == 0: Text {
                    text: "No groups yet. Create one, then add peers from your contacts; they get an invite and choose whether to join.";
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    opacity: 0.7;
                }
            }

            // ---- Groups: one group ----
            if root.tab == 1 && root.open-group != "": VerticalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "‹ Back";
                        clicked => { root.close-group(); }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.group-title;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        if root.group-alias != "": Text {
                            text: root.group-haiku;
                            font-size: 11px;
                            opacity: 0.55;
                            wrap: word-wrap;
                        }
                    }
                    Button {
                        text: "Edit";
                        clicked => {
                            root.edit-kind = "group";
                            root.edit-id = root.open-group;
                            root.edit-original = root.group-haiku;
                            root.edit-text = root.group-alias;
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                    for member in root.members: Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: member.name;
                                font-size: 15px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Badge {
                                y: (parent.height - self.height) / 2;
                                text: member.status;
                                tint: member.kind == 0 ? #22c55e : member.kind == 1 ? #3b82f6 : member.kind == 2 ? #f59e0b : #ef4444;
                            }
                        }
                    }
                    if root.candidates.length > 0: Text {
                        text: "Add from your contacts";
                        font-size: 12px;
                        opacity: 0.7;
                        height: 36px;
                        vertical-alignment: bottom;
                    }
                    for c in root.candidates: Rectangle {
                        height: 48px;
                        HorizontalLayout {
                            spacing: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: c.name;
                                font-size: 15px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Button {
                                text: "Add";
                                clicked => { root.add-to-group(root.open-group, c.id); }
                            }
                        }
                    }
                                    }
                }
                if root.members.length == 0 && root.candidates.length == 0: Text {
                    text: "Nobody here yet, and no contacts to add. Connect to a peer first.";
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    opacity: 0.7;
                }
            }

            // ---- Add by QR ----
            if root.tab == 2: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "Let another device scan this code:";
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: min(root.width - 48px, 300px);
                        background: white;
                        border-radius: 8px;
                        Image {
                            source: root.qr;
                            image-fit: contain;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                        }
                    }
                    Button {
                        text: "Scan a QR code";
                        primary: true;
                        clicked => { root.scan(); }
                    }
                    Text {
                        text: "…or paste a ticket:";
                        opacity: 0.7;
                    }
                    ticket-edit := LineEdit {
                        placeholder-text: "paste ticket here";
                        accepted(t) => { root.connect-ticket(t); }
                    }
                    Button {
                        text: "Connect with ticket";
                        clicked => { root.connect-ticket(ticket-edit.text); }
                    }
                    Text {
                        text: "My ticket (select to copy):";
                        opacity: 0.7;
                    }
                    LineEdit {
                        text: root.ticket;
                        read-only: true;
                    }
                }
            }
        }

        // Footer
        Text {
            text: root.status;
            font-size: 12px;
            opacity: 0.8;
            overflow: elide;
        }
        Text {
            text: root.ble-status;
            font-size: 11px;
            opacity: 0.6;
            overflow: elide;
        }
    }

    if root.edit-kind != "": Rectangle {
        background: #000000.with-alpha(0.55);
        TouchArea {
            clicked => { root.edit-kind = ""; }
        }
        Rectangle {
            width: min(parent.width - 32px, 380px);
            height: card.preferred-height + 24px;
            y: root.safe-area-insets.top + 80px;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.25);
            TouchArea { }
            card := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: root.edit-kind == "peer" ? "Rename contact" : "Rename group";
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.edit-original;
                    font-size: 12px;
                    opacity: 0.55;
                    wrap: word-wrap;
                }
                LineEdit {
                    text <=> root.edit-text;
                    placeholder-text: "Local name (empty restores the original)";
                    accepted(t) => {
                        root.save-edit(root.edit-kind, root.edit-id, t);
                        root.edit-kind = "";
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.save-edit(root.edit-kind, root.edit-id, root.edit-text);
                            root.edit-kind = "";
                        }
                    }
                    Button {
                        text: "Cancel";
                        clicked => { root.edit-kind = ""; }
                    }
                    Button {
                        text: root.edit-kind == "peer" ? "Remove" : "Delete";
                        clicked => {
                            root.delete-edit(root.edit-kind, root.edit-id);
                            root.edit-kind = "";
                        }
                    }
                }
            }
        }
    }
}
