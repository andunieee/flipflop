<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows installer (WiX 3): flipflop.exe into %LOCALAPPDATA%\flipflop for this user (no admin rights), with a
     Start menu entry and an uninstaller. Built by packaging/windows/msi.ps1. The UpgradeCode is the one the jpackage
     installers used, so this one upgrades them. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="flipflop" Language="1033" Version="$(var.Version)" Manufacturer="andunie"
           UpgradeCode="8f3c6a52-5b1e-4f0c-9a57-4d2e7b1c0f31">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited"
             Description="Share files, texts and a scratchpad with your devices, peer to peer" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of flipflop is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="flipflop.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="flipflop.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="flipflop" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <!-- Per-user components are kept by a registry value rather than by their file. -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="App" Guid="5c0e8f1a-3b7d-4e2a-9f61-2d4a8b6c1e03">
        <File Id="FlipflopExe" Source="$(var.Exe)" Name="flipflop.exe" />
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\flipflop" Name="app" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="b7a2d4c9-6e18-4f3b-8a05-9c1e7d3f2b64">
        <Shortcut Id="StartMenuShortcut" Name="flipflop" Description="Share files, texts and a scratchpad with your devices"
                  Target="[INSTALLDIR]flipflop.exe" WorkingDirectory="INSTALLDIR" Icon="flipflop.ico" />
        <RegistryValue Root="HKCU" Key="Software\flipflop" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Level="1">
      <ComponentRef Id="App" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Product>
</Wix>
